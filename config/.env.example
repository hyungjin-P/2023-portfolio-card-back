# 목업 전용 더미 값. 이 파일을 config/.env.development 로 복사해 쓴다(MOCK.md).
# 실제 자격증명이 아니다. 코드가 읽는 키 11개 + 목업 표지 1개만 둔다.
MOCK_ENV_EXAMPLE=1
SERVER_PORT=3000
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_SCHEMA=portfolio_card_back_mock
DATABASE_USERNAME=portfolio_card_back_mock
DATABASE_PASSWORD=mock-local-only
DATABASE_SYNCHRONIZE=true
DATABASE_QUERY_LOGGING=false
AWS_POWER_USER_ACCESS_KEY=mock-access-key
AWS_POWER_USER_SECRET_ACCESS_KEY=mock-secret-key
AWS_POWER_USER_REGION=ap-northeast-2
